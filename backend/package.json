{
  "name": "tareas-hit-backend",
  "version": "2.0.0",
  "description": "Backend API REST con Express, Middlewares, MySQL y Sequelize para Tareas_Hit",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node tests/run-tests.js",
    "test:advanced": "node tests/run-advanced-tests.js",
    "test:all": "node tests/run-tests.js && node tests/run-advanced-tests.js",
    "migrate": "node migrations/run-migrations.js"
  },
  "keywords": [
    "express",
    "middlewares",
    "rest-api",
    "mysql",
    "sequelize",
    "kanban",
    "tareas-hit"
  ],
  "author": "Tareas_Hit Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "sequelize": "^6.37.5"
  }
}
