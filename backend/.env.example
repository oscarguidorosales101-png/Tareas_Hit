# ==========================================
# TAREAS_HIT — CONFIGURACIÓN DE ENTORNO
# ==========================================

# Puerto del servidor backend
PORT=4000
NODE_ENV=development

# Conexión a Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tareas_hit
DB_USER=root
DB_PASSWORD=

# Rate Limiter: Máximo de solicitudes por minuto en funcionamiento normal (50)
RATE_LIMIT_MAX=50

# Integración Opcional con API de Trello
TRELLO_API_KEY=
TRELLO_TOKEN=

